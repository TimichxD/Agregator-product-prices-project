  <property name="styleSheet">
   <string notr="true">
* { font-family: &quot;Nunito&quot;, &quot;Varela Round&quot;, &quot;Segoe UI&quot;, &quot;Corbel&quot;, &quot;Helvetica Neue&quot;, &quot;Noto Sans&quot;, sans-serif; color: #2E3A24; }

QWidget#CatalogPage { background: #F7FAF3; }
QLabel { background: transparent; }

/* ---------- Заголовки ---------- */
QLabel#catalogTitle { font-size: 21pt; font-weight: bold; }
QLabel#catalogSubtitle { font-size: 11pt; color: #8A9B76; }

/* ---------- Поля ввода и комбо-боксы ---------- */
QLineEdit {
    background: #FFFFFF;
    border: 1px solid #DDE7CF;
    border-radius: 20px;
    padding: 10px 18px;
    font-size: 10pt;
    selection-background-color: #CDEE94;
    placeholder-text-color: #A3B38E;
}
QLineEdit:focus { border: 1px solid #8FD630; }

QComboBox {
    background: #FFFFFF;
    border: 1px solid #DDE7CF;
    border-radius: 20px;
    padding: 8px 15px;
    font-size: 10pt;
    color: #2E3A24;
}
QComboBox:focus { border: 1px solid #8FD630; }
QComboBox::drop-down { border: none; }

/* ---------- Таблица ---------- */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 20px;
    gridline-color: transparent;
    font-size: 10pt;
    padding: 6px;
}
QTableWidget::item { padding: 6px 10px; border-bottom: 1px solid #EEF3E6; }
QTableWidget::item:selected { background: #E6F6C3; color: #2E3A24; }
QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E4ECD8;
    padding: 8px 10px;
    color: #6E9A3A;
    font-size: 10pt;
    font-weight: bold;
}

/* ---------- Кнопки действий ---------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C4F56E, stop:1 #8FD630);
    border: 1px solid rgba(255, 255, 255, 230);
    border-radius: 20px;
    padding: 10px 24px;
    font-size: 12pt;
    color: #1E2B12;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D3FA8C, stop:1 #A0E448);
}
QPushButton:pressed {
    background: #84C72A;
}
