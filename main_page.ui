  <property name="styleSheet">
   <string notr="true">
* { font-family: &quot;Nunito&quot;, &quot;Varela Round&quot;, &quot;Segoe UI&quot;, &quot;Corbel&quot;, &quot;Helvetica Neue&quot;, &quot;Noto Sans&quot;, sans-serif; color: #2E3A24; }

QMainWindow, QWidget#centralwidget { background: #F7FAF3; }
QLabel { background: transparent; }

/* ---------- Шапка ---------- */
QLabel#brand      { font-size: 22pt; color: #5AA00F; }
QLabel#brandHint  { font-size: 10pt; color: #8A9B76; }

QLineEdit {
    background: #FFFFFF;
    border: 1px solid #DDE7CF;
    border-radius: 20px;
    padding: 10px 18px;
    font-size: 10pt;
    selection-background-color: #CDEE94;
    placeholder-text-color: #A3B38E;
}
QLineEdit:focus { border: 1px solid #8FD630; }

/* ---------- Салатовые кнопки ---------- */
QPushButton#btnSearch, QPushButton#homeCompareButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C4F56E, stop:1 #8FD630);
    border: 1px solid rgba(255, 255, 255, 230);
    border-radius: 20px;
    padding: 10px 24px;
    font-size: 12pt;
    color: #1E2B12;
}
QPushButton#btnSearch:hover, QPushButton#homeCompareButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D3FA8C, stop:1 #A0E448);
}
QPushButton#btnSearch:pressed, QPushButton#homeCompareButton:pressed {
    background: #84C72A;
}

/* ---------- Карточки ---------- */
QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 20px;
    margin-top: 14px;
    padding: 18px 16px 12px 16px;
    font-size: 10pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 20px;
    padding: 0 8px;
    color: #6E9A3A;
}
QGroupBox#savingCard { background: #F1F9DF; border: 1px solid #DCEBB8; }
QLabel#homeTitle    { font-size: 21pt; }
QLabel#homeSubtitle { font-size: 11pt; color: #8A9B76; }
QLabel#savingValue  { font-size: 24pt; color: #4E8F0C; }
QLabel#savingHint   { font-size: 10pt; color: #6F8458; }
QLabel#offersTitle  { font-size: 13pt; }

/* ---------- Категории ---------- */
QPushButton#catDairy, QPushButton#catMeat, QPushButton#catFruit,
QPushButton#catBakery, QPushButton#catGrocery, QPushButton#catDrinks {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 18px;
    padding: 12px 10px;
    font-size: 10pt;
}
QPushButton#catDairy:hover, QPushButton#catMeat:hover, QPushButton#catFruit:hover,
QPushButton#catBakery:hover, QPushButton#catGrocery:hover, QPushButton#catDrinks:hover {
    background: #F1F9DF;
    border: 1px solid #B9E060;
}

/* ---------- Таблица ---------- */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 20px;
    gridline-color: transparent;
    font-size: 10pt;
    padding: 6px;
}
QTableWidget::item { padding: 6px 10px; border-bottom: 1px solid #EEF3E6; }
QTableWidget::item:selected { background: #E6F6C3; color: #2E3A24; }
QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E4ECD8;
    padding: 8px 10px;
    color: #6E9A3A;
    font-size: 10pt;
}

/* ---------- Нижняя навигация ---------- */
QToolTip { background: #F4FCE6; color: #1E2B12; border: 1px solid #A5E04A; border-radius: 8px; padding: 4px 8px; }

/* ---------- Плавающая стеклянная навигация (как в Telegram) ---------- */
QFrame#navBar {
    background: #FFFFFF;
    border: 1px solid #E2EBD5;
    border-radius: 32px;
}
QPushButton#btnHome, QPushButton#btnCatalog, QPushButton#btnCart, QPushButton#btnMap {
    background: transparent;
    border: none;
    border-radius: 24px;
    padding: 8px 26px;
    min-width: 44px;
    min-height: 36px;
}
QPushButton#btnHome:hover, QPushButton#btnCatalog:hover,
QPushButton#btnCart:hover, QPushButton#btnMap:hover {
    background: rgba(190, 242, 106, 110);
}
QPushButton#btnHome:checked, QPushButton#btnCatalog:checked,
QPushButton#btnCart:checked, QPushButton#btnMap:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C4F56E, stop:1 #9EE23E);
    color: #1E2B12;
}
