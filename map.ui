   <string notr="true">
* { font-family: &quot;Nunito&quot;, &quot;Varela Round&quot;, &quot;Segoe UI&quot;, &quot;Corbel&quot;, &quot;Helvetica Neue&quot;, &quot;Noto Sans&quot;, sans-serif; color: #2E3A24; }

QWidget#MapPage { background: #F7FAF3; }
QLabel { background: transparent; }

/* ---------- Заголовки ---------- */
QLabel#mapTitle { font-size: 21pt; font-weight: bold; }
QLabel#mapSubtitle { font-size: 11pt; color: #8A9B76; }

/* ---------- Фрейм для карты ---------- */
QFrame {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 20px;
    padding: 20px;
}
QLabel#mapPlaceholderLabel { font-size: 12pt; color: #8A9B76; }

/* ---------- Таблица ---------- */
QTableWidget {
    background: #FFFFFF;
    border: 1px solid #E4ECD8;
    border-radius: 20px;
    gridline-color: transparent;
    font-size: 10pt;
    padding: 6px;
}
QTableWidget::item { padding: 6px 10px; border-bottom: 1px solid #EEF3E6; }
QTableWidget::item:selected { background: #E6F6C3; color: #2E3A24; }
QHeaderView::section {
    background: transparent;
    border: none;
    border-bottom: 1px solid #E4ECD8;
    padding: 8px 10px;
    color: #6E9A3A;
    font-size: 10pt;
    font-weight: bold;
}

/* ---------- Кнопки ---------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C4F56E, stop:1 #8FD630);
    border: 1px solid rgba(255, 255, 255, 230);
    border-radius: 20px;
    padding: 10px 24px;
    font-size: 12pt;
    color: #1E2B12;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #D3FA8C, stop:1 #A0E448);
}
QPushButton:pressed {
    background: #84C72A;
}
